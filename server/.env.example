# Copy to server/.env and fill in. Never commit .env.

# The Titan mailbox that SENDS the mail.
SMTP_USER=info@roadlinkconsultancy.in

# The Titan mailbox password (the one you set in GoDaddy/Titan webmail).
SMTP_PASS=

# Where enquiries are delivered. Defaults to SMTP_USER if omitted.
TO_EMAIL=info@roadlinkconsultancy.in

# Sites allowed to POST to this API (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,https://roadlinkconsultancy.in,https://www.roadlinkconsultancy.in

PORT=5000
RATE_LIMIT_MAX=5

# GoDaddy SMTP relay (Titan mailbox).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
