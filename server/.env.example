# Copy to server/.env and fill in. Never commit .env.

# The Gmail account that SENDS the mail.
SMTP_USER=roadlinkconsultancyservices@gmail.com

# A Google APP PASSWORD (16 chars, no spaces) — NOT the account password.
# Requires 2-Step Verification. See README.md for how to generate one.
SMTP_PASS=

# Where enquiries are delivered. Defaults to SMTP_USER if omitted.
TO_EMAIL=roadlinkconsultancyservices@gmail.com

# Sites allowed to POST to this API (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173

PORT=5000
RATE_LIMIT_MAX=5

# Only change these if you move off Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
